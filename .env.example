# Copy this file to .env.local for local testing, and add the same
# variables in Vercel → Project → Settings → Environment Variables.

# Enquiry form email delivery (free account at https://resend.com)
RESEND_API_KEY=
# Where enquiries should arrive
ENQUIRY_TO_EMAIL=
# Sender address. Use onboarding@resend.dev until you verify skyyhan.com in Resend.
ENQUIRY_FROM_EMAIL=Skyyhan Website <onboarding@resend.dev>
